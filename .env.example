APP_NAME=gps-billing-mvp
DATABASE_URL=sqlite:///./billing.db

# Billing behavior
DEFAULT_DISABLE_AFTER_DAY=10
MONTHLY_BILLING_HOUR=21
MONTHLY_BILLING_MINUTE=0
OVERDUE_CHECK_HOUR=7
OVERDUE_CHECK_MINUTE=0

# Monitoring API
MONITORING_API_BASE_URL=https://monitoring.local/api
MONITORING_API_TOKEN=replace-me

# Accounting API
ACCOUNTING_API_BASE_URL=https://accounting.local/api
ACCOUNTING_API_TOKEN=replace-me

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_SENDER=billing@example.com

# Chpok monorepo
CHPOK_API_BASE_URL=http://localhost:8000
CHPOK_ADMIN_BASE_URL=http://localhost:3000
CHPOK_SUPABASE_URL=https://your-project.supabase.co
CHPOK_SUPABASE_ANON_KEY=public-anon-key-here
CHPOK_SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# Frontend env for Chpok (placeholders only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase-publishable-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase-publishable-key-here
